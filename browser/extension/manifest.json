{
  "manifest_version": 3,
  "name": "Beatit Download Manager",
  "version": "0.2.0",
  "description": "Automatically intercept browser downloads and detect direct, HLS, DASH, and supported video-page media.",
  "permissions": [
    "nativeMessaging",
    "webRequest",
    "tabs",
    "downloads",
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Beatit Download Manager",
    "default_popup": "popup.html"
  },
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "beatit@example.org"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
