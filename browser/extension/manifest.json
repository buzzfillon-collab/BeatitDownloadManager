{
  "manifest_version": 3,
  "name": "Beatit Download Manager",
  "version": "0.1.0",
  "description": "Send browser downloads and non-DRM media streams to Beatit.",
  "permissions": ["nativeMessaging", "webRequest", "tabs", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Download with Beatit"}
}