{
  "manifest_version": 2,
  "name": "Beatit Download Manager",
  "version": "0.2.0",
  "description": "Automatically intercept browser downloads and detect direct, HLS, DASH, and supported video-page media.",
  "permissions": [
    "nativeMessaging",
    "webRequest",
    "tabs",
    "downloads",
    "contextMenus",
    "storage",
    "notifications",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Beatit Download Manager",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "beatit@example.org",
      "strict_min_version": "115.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
